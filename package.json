{
  "name": "progrit-study-log",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "worker:dev": "wrangler dev worker/index.ts --local",
    "worker:deploy": "wrangler deploy worker/index.ts",
    "pages:deploy": "wrangler pages deploy public --project-name progrit-study-log",
    "typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "test": "esbuild worker/index.test.ts --bundle --platform=node --format=esm --outfile=.test-out/index.test.mjs --log-level=warning && node --test .test-out/index.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.5.3",
    "wrangler": "^4.95.0"
  }
}
